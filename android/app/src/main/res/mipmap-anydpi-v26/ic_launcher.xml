<?xml version="1.0" encoding="utf-8"?>
<!-- Full-bleed brand icon (cream torn-paper P). The opaque source image fills the
     108dp canvas as both layers, so the launcher mask crops it exactly like iOS —
     no white margin, no seam against the paper's vignette. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_foreground" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
